# StreetShift environment template
# Copy to .env (never commit .env) and fill in. Values marked [TEST RUN] are needed for the
# few-hour test run; everything else can stay blank, with its USE_MOCK_* flag set to true.

# --- Anthropic (Claude) [TEST RUN] ---
# Claude Console -> API keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5

# --- Apify [TEST RUN] ---
# Apify Console -> Settings -> API & Integrations -> personal API token
APIFY_TOKEN=

# --- Elastic Cloud Serverless [TEST RUN] ---
# Create a free project at https://ela.st/calhacks -> Connection details.
# KIBANA_URL is the same URL with .es. replaced by .kb.
ELASTICSEARCH_URL=
KIBANA_URL=
ELASTIC_API_KEY=
EMBEDDING_INFERENCE_ID=.jina-embeddings-v5-text-small

# --- SpacetimeDB [TEST RUN] ---
# Install the SpacetimeDB CLI, then either run locally (`spacetime start`) or log in to their cloud.
# Claude Code will fill these after publishing the module.
SPACETIMEDB_URI=
SPACETIMEDB_MODULE=streetshift
SPACETIMEDB_TOKEN=
SPACETIMEDB_DB_NAME=streetshift-qf01o
SIM_PORT=8787

# --- Map [TEST RUN] ---
# Free dark basemap, no key needed.
MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# --- US Census (population per block group) ---
# api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# --- NYC Open Data (optional, avoids rate limits) ---
# data.cityofnewyork.us -> sign in -> Developer Settings -> create app token
DATASF_APP_TOKEN=
NYC_OPEN_DATA_APP_TOKEN=

# --- Convex (full build) ---
# Run `npx convex dev` in /convex; it logs you in and writes these to .env.local.
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=

# --- Factory Droid SDK (full build) ---
# Factory app -> Settings -> API keys
FACTORY_API_KEY=

# --- Fetch.ai (full build) ---
# Agentverse: agentverse.ai -> profile -> API keys
# ASI:One: asi1.ai/dashboard/api-keys
# Seeds: one random secret phrase per agent; Claude Code can generate these. Never reuse or share them.
AGENTVERSE_API_KEY=
ASI1_API_KEY=
AGENT_SEED_ANALYST=
AGENT_SEED_CAFE=
AGENT_SEED_COMMUTER=
AGENT_SEED_RESIDENT=
AGENT_SEED_PARENT=

# --- Moss (full build) ---
# Sign up at moss.dev -> create a project -> project ID and key
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# --- LiveKit (full build) ---
# Create a LiveKit Cloud project, then let the `lk` CLI write these. Don't hand-type them.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Flags ---
DEMO_MODE=false
USE_MOCK_APIFY=false
USE_MOCK_ELASTIC=false
USE_MOCK_SPACETIME=false
USE_MOCK_CONVEX=false
USE_MOCK_DROID=false
USE_MOCK_FETCH=false
USE_MOCK_MOSS=true
USE_MOCK_VOICE=true
DROID_WORKER_SECRET=
